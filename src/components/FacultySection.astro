---
import { facultyList } from '../data/faculty';
import Icon from './Icon.astro';

interface Props {
  isPageHeading?: boolean;
}

const { isPageHeading = true } = Astro.props;

const totalExperience = facultyList.reduce((acc, f) => acc + f.years, 0);
const totalFaculty = facultyList.length;

function getInitials(name: string): string {
  return name
    .split(' ')
    .filter(Boolean)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
}
---

<section id="faculty" class="section-fluid bg-[#090909]" aria-labelledby="faculty-heading">
  <div class="container-wide">
    {/* Section Heading & Subtitle */}
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-12">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider text-[#FFCB00] bg-[#FFCB00]/10 border border-[#FFCB00]/30 mb-3">
        Academic Mentors
      </span>
      {isPageHeading ? (
        <h1 id="faculty-heading" class="text-3xl sm:text-4xl lg:text-5xl font-mono font-bold text-white tracking-tight">
          Our Faculty
        </h1>
      ) : (
        <h2 id="faculty-heading" class="text-3xl sm:text-4xl lg:text-5xl font-mono font-bold text-white tracking-tight">
          Our Faculty
        </h2>
      )}
      <p class="text-base sm:text-lg font-mono text-[#999999] mt-3 leading-relaxed max-w-2xl mx-auto">
        Dedicated classroom educators preparing students for IIT-JEE, NEET-UG, and Foundations in Jalgaon &amp; Bhusawal.
      </p>
    </div>

    {/* Computed Stat Strip */}
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-12 py-4 px-6 rounded-2xl bg-[#141414] border border-[#262626] mb-12 max-w-xl mx-auto">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#FFCB00]/10 border border-[#FFCB00]/30 flex items-center justify-center text-[#FFCB00] shrink-0">
          <Icon name="award" size={20} class="text-[#FFCB00]" />
        </div>
        <div>
          <div class="text-xl sm:text-2xl font-mono font-bold text-white leading-tight">
            {totalExperience}+ Years
          </div>
          <div class="text-xs sm:text-sm font-mono text-[#999999]">
            Combined Experience
          </div>
        </div>
      </div>

      <div class="hidden sm:block w-px h-8 bg-[#262626]"></div>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#FFCB00]/10 border border-[#FFCB00]/30 flex items-center justify-center text-[#FFCB00] shrink-0">
          <Icon name="graduation-cap" size={20} class="text-[#FFCB00]" />
        </div>
        <div>
          <div class="text-xl sm:text-2xl font-mono font-bold text-white leading-tight">
            {totalFaculty} Mentors
          </div>
          <div class="text-xs sm:text-sm font-mono text-[#999999]">
            Subject Specialists
          </div>
        </div>
      </div>
    </div>

    {/* Faculty Cards Grid (1 col mobile, 2 cols tablet, 3 cols desktop, centered last row) */}
    <div class="faculty-grid">
      {facultyList.map((member) => (
        <article class="faculty-card bg-[#141414] border border-[#262626] rounded-2xl p-6 font-mono flex flex-col justify-between transition-[border-color,transform] duration-200 ease-out hover:border-[#FFCB00]/40 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:transform-none">
          <div>
            {/* Top Row: Subject Chip */}
            <div class="flex items-center justify-between mb-5">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider text-[#FFCB00] bg-[#FFCB00]/10 border border-[#FFCB00]/30">
                {member.subject}
              </span>
            </div>

            {/* Avatar & Identification */}
            <div class="flex items-start gap-4 mb-4">
              <div class="faculty-avatar">
                {member.photo ? (
                  <img
                    src={member.photo}
                    alt={`${member.name} ${member.title}, ${member.subject} faculty`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <span>{getInitials(member.name)}</span>
                )}
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="text-lg sm:text-xl font-mono font-semibold text-white leading-snug">
                  {member.name} {member.title}
                </h3>
                <p class="text-sm font-mono font-medium text-[#e0e0e0] mt-1 leading-snug">
                  {member.qualification}
                </p>
              </div>
            </div>
          </div>

          {/* Bottom Row Divider + Experience */}
          <div class="pt-4 mt-4 border-t border-[#262626] flex items-center justify-between text-xs sm:text-sm font-mono">
            <span class="text-[#888888]">Experience</span>
            <span class="text-white font-semibold">
              {member.years} yrs experience
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .faculty-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .faculty-card {
    width: 100%;
    max-width: 28rem;
  }

  @media (min-width: 640px) {
    .faculty-card {
      width: calc(50% - 0.75rem);
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .faculty-card {
      width: calc((100% - 3rem) / 3);
      max-width: none;
    }
  }

  .faculty-avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    border: 2px solid #FFCB00;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFCB00;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    overflow: hidden;
    flex-shrink: 0;
  }
</style>
