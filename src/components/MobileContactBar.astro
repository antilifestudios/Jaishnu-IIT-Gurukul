---
import Icon from './Icon.astro';

interface Props {
  phone?: string;
  whatsapp?: string;
}

const {
  phone = "+919860267927",
  whatsapp = "919860267927"
} = Astro.props;

const whatsappUrl = `https://wa.me/${whatsapp}?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20Pace%20Jaishnu%20IIT%20Gurukul%20batches`;
---

<aside
  class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-[#090909]/95 backdrop-blur-md border-t border-[#262626] px-4 py-3"
  aria-label="Quick Mobile Admissions Actions"
>
  <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
    {/* Direct Tap to Call */}
    <a
      href={`tel:${phone}`}
      class="flex items-center justify-center gap-2 py-3 px-4 text-base font-mono font-semibold text-white bg-[#141414] border border-[#333333] rounded-full min-h-[52px] active:scale-95 transition-transform no-underline"
      aria-label="Call Admissions directly"
    >
      <Icon name="phone" size={20} class="text-[#FFCB00]" />
      <span>Call Now</span>
    </a>

    {/* Primary WhatsApp Action */}
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 py-3 px-4 text-base font-mono font-bold text-black bg-[#FFCB00] rounded-full min-h-[52px] active:scale-95 transition-transform shadow-lg shadow-[#FFCB00]/20 no-underline"
      aria-label="Enquire on WhatsApp"
    >
      <Icon name="whatsapp" size={20} class="text-black" />
      <span>WhatsApp</span>
    </a>
  </div>
</aside>
