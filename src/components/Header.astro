---
import StaticLogo from './StaticLogo.astro';
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/courses', label: 'Courses' },
  { href: '/faculty', label: 'Faculty' },
  { href: '/results', label: 'Results' },
  { href: '/reviews', label: 'Reviews' },
];

function isActive(href: string): boolean {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
}
---

<header class="sticky top-0 z-40 w-full bg-[#090909]/95 backdrop-blur-md border-b border-[#262626]">
  {/* ROW 1: Brand (left) + Navigation (desktop left) + CTAs (right) */}
  <div class="w-full px-4 sm:px-5 md:px-8 flex items-center justify-between h-16 md:h-20">
    {/* LEFT group: Brand block followed by desktop nav links */}
    <div class="flex items-center gap-4 lg:gap-8 min-w-0">
      {/* Brand Block */}
      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
        <StaticLogo height={42} />
        <div class="border-l border-[#333333] pl-2.5 sm:pl-3 py-1 flex flex-col justify-center h-10">
          <span class="block text-[11px] sm:text-[13px] font-mono tracking-wider text-[#999999] uppercase leading-none whitespace-nowrap">
            PACE IIT &amp; MEDICAL PARTNER
          </span>
          <span class="block text-[14px] sm:text-[17px] font-mono text-white font-semibold leading-tight whitespace-nowrap mt-1">
            Jalgaon &amp; Bhusawal
          </span>
        </div>
      </div>

      {/* Desktop Nav Links (16px, flush next to brand block) */}
      <nav class="hidden md:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "px-3 py-2 text-[16px] font-mono transition-colors rounded-md whitespace-nowrap",
              isActive(link.href)
                ? "text-[#FFCB00] font-semibold"
                : "text-[#d1d1d1] hover:text-white hover:bg-[#141414] no-underline"
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    {/* RIGHT group: Call dropdown button + WhatsApp button */}
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      {/* Call Button & Dropdown Container */}
      <div class="relative" id="call-dropdown-container">
        <button
          id="call-dropdown-btn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="call-dropdown-panel"
          class="inline-flex items-center justify-center gap-2 h-[44px] w-[44px] md:w-auto md:min-w-[124px] px-0 md:px-4 font-mono text-sm font-semibold text-white bg-[#141414] border border-[#333333] rounded-full hover:bg-[#1c1c1c] hover:border-[#555555] active:scale-95 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FFCB00] shrink-0"
          aria-label="Call admissions numbers"
        >
          <Icon name="phone" size={18} class="text-[#FFCB00] shrink-0" />
          <span class="hidden md:inline whitespace-nowrap">Call Us</span>
          <svg
            class="hidden md:inline w-4 h-4 text-[#999999] transition-transform duration-200 chevron-icon shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        {/* Dropdown Panel (Desktop 340px, Mobile max calc(100vw - 24px) anchored to right edge) */}
        <div
          id="call-dropdown-panel"
          role="menu"
          aria-label="Direct Phone Lines"
          class="hidden absolute right-0 mt-2 w-[340px] max-w-[calc(100vw-24px)] bg-[#141414] border border-[#262626] rounded-2xl shadow-2xl p-3 z-50 transition-all"
        >
          {/* Accessibility Live Announcement for Copy Action */}
          <div class="sr-only" aria-live="polite" id="copy-announcement"></div>

          {/* JALGAON Group */}
          <div class="px-3 pt-2 pb-1 text-[14px] font-mono font-bold tracking-wider text-[#FFCB00] uppercase">
            Jalgaon
          </div>
          <div class="flex flex-col gap-1.5">
            {/* Jalgaon Number 1 */}
            <a
              href="tel:+919607888009"
              data-phone="9607888009"
              role="menuitem"
              class="number-row flex items-center justify-between px-4 py-3 min-h-[56px] rounded-xl bg-[#1a1a1a] hover:bg-[#222222] border border-[#2a2a2a] hover:border-[#444444] text-white transition-all no-underline group cursor-pointer"
            >
              <div class="row-content flex flex-col justify-center min-w-0">
                <span class="phone-digits text-[20px] font-mono font-semibold tracking-[0.02em] text-white group-hover:text-[#FFCB00] transition-colors leading-tight">
                  9607888009
                </span>
              </div>
              <div class="icon-indicator flex items-center justify-center shrink-0 ml-3">
                <Icon name="phone" size={22} class="text-[#FFCB00]" />
              </div>
            </a>

            {/* Jalgaon Number 2 (Center Director) */}
            <a
              href="tel:+919860267927"
              data-phone="9860267927"
              role="menuitem"
              class="number-row flex items-center justify-between px-4 py-3 min-h-[56px] rounded-xl bg-[#1a1a1a] hover:bg-[#222222] border border-[#2a2a2a] hover:border-[#444444] text-white transition-all no-underline group cursor-pointer"
            >
              <div class="row-content flex flex-col justify-center min-w-0">
                <span class="phone-digits text-[20px] font-mono font-semibold tracking-[0.02em] text-white group-hover:text-[#FFCB00] transition-colors leading-tight">
                  9860267927
                </span>
                <span class="director-label text-[15px] font-sans text-[#cccccc] font-medium leading-tight mt-1">
                  Center Director
                </span>
              </div>
              <div class="icon-indicator flex items-center justify-center shrink-0 ml-3">
                <Icon name="phone" size={22} class="text-[#FFCB00]" />
              </div>
            </a>
          </div>

          <div class="h-px bg-[#262626] my-2.5"></div>

          {/* BHUSAWAL Group */}
          <div class="px-3 pt-1 pb-1 text-[14px] font-mono font-bold tracking-wider text-[#FFCB00] uppercase">
            Bhusawal
          </div>
          <div class="flex flex-col gap-1.5">
            {/* Bhusawal Number 1 */}
            <a
              href="tel:+919607883003"
              data-phone="9607883003"
              role="menuitem"
              class="number-row flex items-center justify-between px-4 py-3 min-h-[56px] rounded-xl bg-[#1a1a1a] hover:bg-[#222222] border border-[#2a2a2a] hover:border-[#444444] text-white transition-all no-underline group cursor-pointer"
            >
              <div class="row-content flex flex-col justify-center min-w-0">
                <span class="phone-digits text-[20px] font-mono font-semibold tracking-[0.02em] text-white group-hover:text-[#FFCB00] transition-colors leading-tight">
                  9607883003
                </span>
              </div>
              <div class="icon-indicator flex items-center justify-center shrink-0 ml-3">
                <Icon name="phone" size={22} class="text-[#FFCB00]" />
              </div>
            </a>

            {/* Bhusawal Number 2 (Center Director) */}
            <a
              href="tel:+918551000666"
              data-phone="8551000666"
              role="menuitem"
              class="number-row flex items-center justify-between px-4 py-3 min-h-[56px] rounded-xl bg-[#1a1a1a] hover:bg-[#222222] border border-[#2a2a2a] hover:border-[#444444] text-white transition-all no-underline group cursor-pointer"
            >
              <div class="row-content flex flex-col justify-center min-w-0">
                <span class="phone-digits text-[20px] font-mono font-semibold tracking-[0.02em] text-white group-hover:text-[#FFCB00] transition-colors leading-tight">
                  8551000666
                </span>
                <span class="director-label text-[15px] font-sans text-[#cccccc] font-medium leading-tight mt-1">
                  Center Director
                </span>
              </div>
              <div class="icon-indicator flex items-center justify-center shrink-0 ml-3">
                <Icon name="phone" size={22} class="text-[#FFCB00]" />
              </div>
            </a>
          </div>
        </div>
      </div>

      {/* WhatsApp Button (Identical dimensions: 44x44px icon-only on mobile, 44px pill with text on desktop) */}
      <a
        href="https://wa.me/919860267927?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20Pace%20Jaishnu%20IIT%20Gurukul%20batches"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 h-[44px] w-[44px] md:w-auto md:min-w-[124px] px-0 md:px-4 font-mono text-sm font-bold text-black bg-[#FFCB00] border border-[#FFCB00] rounded-full hover:bg-[#e6b800] active:scale-95 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FFCB00] no-underline shrink-0"
        aria-label="Enquire via WhatsApp"
      >
        <Icon name="whatsapp" size={18} class="text-black shrink-0" />
        <span class="hidden md:inline whitespace-nowrap">WhatsApp</span>
      </a>
    </div>
  </div>

  {/* ROW 2: Mobile Nav Links (<768px: single line, 13px, nowrap, overflow-x: auto) */}
  <nav
    class="md:hidden w-full border-t border-[#1c1c1c] px-4 py-2 overflow-x-auto scrollbar-none"
    aria-label="Mobile Navigation Bar"
  >
    <div class="flex items-center gap-1.5 min-w-max">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "px-3 py-1.5 text-[13px] font-mono transition-colors rounded-full whitespace-nowrap",
            isActive(link.href)
              ? "bg-[#1c1c1c] text-[#FFCB00] font-semibold border border-[#333333]"
              : "text-[#cccccc] hover:text-white hover:bg-[#141414] no-underline"
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  /* Clean horizontal scrollbar hiding for mobile row */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function setupHeader() {
    const callBtn = document.getElementById('call-dropdown-btn');
    const callPanel = document.getElementById('call-dropdown-panel');
    const callContainer = document.getElementById('call-dropdown-container');
    const announcement = document.getElementById('copy-announcement');

    if (!callBtn || !callPanel || !callContainer) return;

    const chevron = callBtn.querySelector('.chevron-icon');

    function openDropdown() {
      callBtn?.setAttribute('aria-expanded', 'true');
      callPanel?.classList.remove('hidden');
      chevron?.classList.add('rotate-180');
    }

    function closeDropdown() {
      callBtn?.setAttribute('aria-expanded', 'false');
      callPanel?.classList.add('hidden');
      chevron?.classList.remove('rotate-180');
    }

    // Toggle dropdown on button click
    callBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = callBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Close on clicking outside
    document.addEventListener('click', (e) => {
      if (!callContainer.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Close on Escape key and return focus
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && callBtn.getAttribute('aria-expanded') === 'true') {
        closeDropdown();
        callBtn.focus();
      }
    });

    // Device detection: touch vs pointer
    function isTouchDevice(): boolean {
      return (
        window.matchMedia('(hover: none) and (pointer: coarse)').matches ||
        'ontouchstart' in window ||
        navigator.maxTouchPoints > 0
      );
    }

    // Clipboard copy with fallback for non-secure / older browsers
    async function copyToClipboard(text: string): Promise<boolean> {
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // fall through to fallback
        }
      }

      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-999999px';
      textArea.style.top = '-999999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();

      let success = false;
      try {
        success = document.execCommand('copy');
      } catch {
        success = false;
      }
      document.body.removeChild(textArea);
      return success;
    }

    // Number rows click handling
    const numberRows = callPanel.querySelectorAll<HTMLAnchorElement>('.number-row');

    numberRows.forEach((row) => {
      const rowContent = row.querySelector('.row-content') as HTMLElement | null;
      let timeoutId: ReturnType<typeof setTimeout> | null = null;
      const originalHTML = rowContent ? rowContent.innerHTML : '';

      row.addEventListener('click', async (e) => {
        // If touch device, allow native tel: link behavior to open dialer
        if (isTouchDevice()) {
          return;
        }

        // Pointer / Desktop device: copy to clipboard
        e.preventDefault();
        e.stopPropagation();

        const phoneDigits = row.getAttribute('data-phone') || '';
        await copyToClipboard(phoneDigits);

        // Update accessibility live announcement
        if (announcement) {
          announcement.textContent = `Copied ${phoneDigits} to clipboard`;
        }

        // Visual feedback: show "Copied ✓" in yellow for ~1.5s
        if (rowContent) {
          if (timeoutId) clearTimeout(timeoutId);
          rowContent.innerHTML = `
            <span class="text-[20px] font-mono font-bold text-[#FFCB00] leading-tight flex items-center gap-1.5">
              Copied ✓
            </span>
          `;

          timeoutId = setTimeout(() => {
            rowContent.innerHTML = originalHTML;
          }, 1500);
        }
      });
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
