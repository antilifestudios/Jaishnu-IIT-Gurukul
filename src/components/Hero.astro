---
import LogoGlow from './LogoGlow.astro';

interface Props {
  phone?: string;
  whatsapp?: string;
}

const {
  phone = "+919860267927",
  whatsapp = "919860267927"
} = Astro.props;
---

<section class="relative py-10 sm:py-12 md:py-16 bg-[#090909] border-b border-[#1c1c1c] overflow-hidden flex flex-col justify-center">
  {/* Visually hidden H1 for SEO and Screen Readers */}
  <h1 class="sr-only">
    IIT-JEE &amp; NEET-UG Coaching in Jalgaon &amp; Bhusawal | Jaishnu IIT Gurukul
  </h1>

  <div class="w-full px-4 sm:px-5 md:px-8">
    <div class="max-w-6xl mx-auto flex flex-col items-center">
      {/* CENTERED ANIMATED LOGO AT THE TOP */}
      <div class="w-full flex justify-center mb-8 sm:mb-10">
        <div class="w-full max-w-[340px] sm:max-w-[420px] md:max-w-[480px]">
          <LogoGlow theme="dark" size="hero" class="mx-auto" />
        </div>
      </div>

      {/* THE 3 INFO BOXES DIRECTLY BENEATH (~40px gap): ONE ROW on desktop, equal width & equal height, stacked on mobile (<768px) */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full max-w-[940px] items-stretch">
        {/* Box 1: Locations */}
        <div class="info-card flex flex-col justify-center h-full min-h-[96px] sm:min-h-[104px] px-6 sm:px-7 py-5 sm:py-6 rounded-2xl bg-[#141414] border border-[#262626]">
          <span class="block text-[14px] font-mono font-medium uppercase tracking-[0.08em] text-[#cccccc] leading-none mb-2.5">
            LOCATIONS
          </span>
          <span class="block text-[20px] md:text-[22px] font-mono font-semibold text-white leading-snug">
            Jalgaon &amp; Bhusawal
          </span>
        </div>

        {/* Box 2: Target Batches */}
        <div class="info-card flex flex-col justify-center h-full min-h-[96px] sm:min-h-[104px] px-6 sm:px-7 py-5 sm:py-6 rounded-2xl bg-[#141414] border border-[#262626]">
          <span class="block text-[14px] font-mono font-medium uppercase tracking-[0.08em] text-[#cccccc] leading-none mb-2.5">
            TARGET BATCHES
          </span>
          <span class="block text-[20px] md:text-[22px] font-mono font-semibold text-white leading-snug">
            6th - 12th &amp; Droppers
          </span>
        </div>

        {/* Box 3: Program Focus */}
        <div class="info-card flex flex-col justify-center h-full min-h-[96px] sm:min-h-[104px] px-6 sm:px-7 py-5 sm:py-6 rounded-2xl bg-[#141414] border border-[#262626]">
          <span class="block text-[14px] font-mono font-medium uppercase tracking-[0.08em] text-[#cccccc] leading-none mb-2.5">
            PROGRAM FOCUS
          </span>
          <span class="block text-[20px] md:text-[22px] font-mono font-semibold text-white leading-snug">
            IIT-JEE &amp; NEET-UG
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
